<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:JADY.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="JADY.UI.Views.Controls.FileAttachmentControl"
             x:DataType="viewModels:FileAttachmentViewModel">
    
    <Border Background="{DynamicResource InsetControlBackground}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="6">
        
        <Grid ColumnDefinitions="*, Auto, Auto" Margin="10">
            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{Binding OriginalFileName}"/>
            <TextBlock Grid.Column="1" Name="FileSize" HorizontalAlignment="Right"/>
            <IconButton Grid.Column="2" IconData="{StaticResource TrashIconSolid}" Command="{Binding RemoveFromEditWindowCommand}"></IconButton>
        </Grid>
    </Border>
    
</UserControl>
